 }
 else if(spell==4u){
  amount=(201.0+roll*32.0+(2.5/3.5)*p)*(s.immTicks>0u?1.25:1.0)*currentFireMult()*(1.0+c.afBonus);
  crit=random01()<c.fireCrit;
