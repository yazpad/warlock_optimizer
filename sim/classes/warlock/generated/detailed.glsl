 case 8u:if(s.now>=s.tranceEnd)s.trance=0u;break;
 case 10u:enqueue(s.now+5000000u,10u,0u,0u);break;
 case 16u:
  s.casting=0u;countCast(14u);enqueue(s.now,17u,0u,0u);decide();break;
