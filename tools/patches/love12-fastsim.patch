+// Fastsim alteration. Explicit requests fail rather than falling back.
+void Graphics::validateFastsimSubgroupSize(uint32 size) const
+{
+	if (!fastsimSubgroupEnabled || size < fastsimSubgroupProperties.minSubgroupSize
+		|| size > fastsimSubgroupProperties.maxSubgroupSize || (size & (size - 1)) != 0
+		|| (fastsimSubgroupProperties.requiredSubgroupSizeStages & VK_SHADER_STAGE_COMPUTE_BIT) == 0)
+		throw love::Exception("Fastsim required compute subgroup size %u is unsupported", size);
+}
+
+void Graphics::beginFastsimComputeTiming()
+{
+	if (fastsimTiming)
+		throw love::Exception("Fastsim compute timing is already active");
+	if (fastsimTimestampBits == 0 || fastsimTimestampPeriod <= 0)
+		throw love::Exception("Fastsim compute timestamps are unsupported");
+	if (fastsimQueryPool == VK_NULL_HANDLE)
+	{
+		VkQueryPoolCreateInfo info{};
+		info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+		info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+		info.queryCount = 8192;
+		VkResult result = vkCreateQueryPool(device, &info, nullptr, &fastsimQueryPool);
+		if (result != VK_SUCCESS)
+			throw love::Exception("Fastsim query pool creation failed: %s", Vulkan::getErrorString(result));
+	}
+	fastsimQueryCount = 0;
+	fastsimTiming = true;
+}
+
+double Graphics::endFastsimComputeTiming(uint32 &dispatches)
+{
+	if (!fastsimTiming)
+		throw love::Exception("Fastsim compute timing is not active");
+	fastsimTiming = false;
+	dispatches = fastsimQueryCount / 2;
+	if (fastsimQueryCount == 0)
+		return 0;
+	std::vector<uint64_t> values(fastsimQueryCount * 2);
+	VkResult result = vkGetQueryPoolResults(device, fastsimQueryPool, 0, fastsimQueryCount,
+		values.size() * sizeof(uint64_t), values.data(), sizeof(uint64_t) * 2,
+		VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WITH_AVAILABILITY_BIT);
+	if (result != VK_SUCCESS)
+		throw love::Exception("Fastsim GPU timestamps unavailable; finish readbacks before collecting timing");
+	uint64_t mask = fastsimTimestampBits == 64 ? UINT64_MAX : ((uint64_t(1) << fastsimTimestampBits) - 1);
+	double ticks = 0;
+	for (uint32 i = 0; i < fastsimQueryCount; i += 2)
+	{
+		if (values[i * 2 + 1] == 0 || values[(i + 1) * 2 + 1] == 0)
+			throw love::Exception("Fastsim GPU timestamp was not available");
+		ticks += double((values[(i + 1) * 2] - values[i * 2]) & mask);
+	}
+	return ticks * double(fastsimTimestampPeriod) / 1e6;
+}
