      s.petBrandCasts++;
      if(random01()<c.hit){
       bool brandCrit=random01()<c.crit;if(brandCrit){brandDmg*=1.5;s.petBrandCrits++;}
       brandDmg*=resistanceMultiplier();s.total+=brandDmg;eventDamage+=brandDmg;s.petDamage+=brandDmg;s.petBrandDamage+=brandDmg;s.petBrandHits++;
      }else{s.petBrandMisses++;}
     }
     s.total+=dmg;eventDamage+=dmg;s.petDamage+=dmg;s.petSpellDamage+=dmg;if(crit)eventFlags|=1u;
    }else{
     s.petSpellMisses++;
    }
   }else{
    delay=petManaWait(160.0);
