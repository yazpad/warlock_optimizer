+// Fastsim-specific extension, not an upstream LÖVE API.
+static int w_fastsimComputeTiming(lua_State *L)
+{
+#ifdef LOVE_GRAPHICS_VULKAN
+	auto gfx = dynamic_cast<vulkan::Graphics *>(instance());
+	if (!gfx)
+		return luaL_error(L, "Fastsim compute timing requires Vulkan");
+	bool begin = luax_toboolean(L, 1);
+	uint32 dispatches = 0;
+	double milliseconds = 0;
+	luax_catchexcept(L, [&]() {
+		if (begin) gfx->beginFastsimComputeTiming();
+		else milliseconds = gfx->endFastsimComputeTiming(dispatches);
+	});
+	lua_pushnumber(L, milliseconds);
+	lua_pushinteger(L, dispatches);
+	return 2;
+#else
+	return luaL_error(L, "Fastsim compute timing requires Vulkan");
+#endif
+}
